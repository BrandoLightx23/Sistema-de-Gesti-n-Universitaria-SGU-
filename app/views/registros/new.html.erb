<div style="text-align: center; margin-top: 50px; font-family: sans-serif;">
  <h1 style="color: #2c3e50;">Crear Cuenta Nueva</h1>
  <p style="color: #7f8c8d;">Únete al Sistema de Gestión Universitaria</p>

  <div style="background-color: #f8f9fa; border: 1px solid #ddd; padding: 30px; margin: 20px auto; width: 350px; border-radius: 8px; text-align: left;">
    
    <%= form_with model: @usuario, url: registro_path, local: true do |f| %>
      
      <% if @usuario.errors.any? %>
        <div style="color: #c0392b; margin-bottom: 15px;">Revise los errores para continuar.</div>
      <% end %>

      <div style="margin-bottom: 15px;">
        <%= f.label :nombre, "Nombre Completo", style: "display: block; font-weight: bold;" %>
        <%= f.text_field :nombre, required: true, style: "width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;" %>
      </div>

      <div style="margin-bottom: 15px;">
        <%= f.label :correo, "Correo Electrónico", style: "display: block; font-weight: bold;" %>
        <%= f.email_field :correo, required: true, style: "width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;" %>
      </div>

      <div style="margin-bottom: 15px;">
        <%= f.label :tipo_usuario, "Rol en la Universidad", style: "display: block; font-weight: bold;" %>
        <%= f.select :tipo_usuario, ["Seleccione un rol...", "Estudiante", "Docente", "Administrativo"], {}, id: "select_rol", required: true, style: "width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;" %>
      </div>

      <div id="campos_estudiante" style="display: none; background: #e8f8f5; padding: 15px; margin-bottom: 15px; border-radius: 4px; border-left: 4px solid #1abc9c;">
        <label style="display: block; font-weight: bold; font-size: 14px;">Matrícula:</label>
        <input type="text" name="matricula" style="width: 100%; padding: 6px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px;">
        
        <label style="display: block; font-weight: bold; font-size: 14px;">Semestre Actual:</label>
        <input type="number" name="semestre_actual" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
      </div>

      <div id="campos_docente" style="display: none; background: #fdf2e9; padding: 15px; margin-bottom: 15px; border-radius: 4px; border-left: 4px solid #e67e22;">
        <label style="display: block; font-weight: bold; font-size: 14px;">Número de Empleado:</label>
        <input type="text" name="numero_empleado" style="width: 100%; padding: 6px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px;">
        
        <label style="display: block; font-weight: bold; font-size: 14px;">Departamento:</label>
        <input type="text" name="departamento" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
      </div>

      <div id="campos_administrativo" style="display: none; background: #ebf5fb; padding: 15px; margin-bottom: 15px; border-radius: 4px; border-left: 4px solid #3498db;">
        <label style="display: block; font-weight: bold; font-size: 14px;">Cargo Institucional:</label>
        <input type="text" name="cargo" style="width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px;">
      </div>

      <div style="margin-bottom: 15px;">
        <%= f.label :password, "Contraseña", style: "display: block; font-weight: bold;" %>
        <%= f.password_field :password, required: true, style: "width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;" %>
      </div>

      <div style="margin-bottom: 20px;">
        <%= f.label :password_confirmation, "Confirmar Contraseña", style: "display: block; font-weight: bold;" %>
        <%= f.password_field :password_confirmation, required: true, style: "width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;" %>
      </div>

      <%= f.submit "Registrarse", style: "width: 100%; background-color: #27ae60; color: white; padding: 10px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;" %>
    <% end %>

  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const selectRol = document.getElementById("select_rol");
    const divEstudiante = document.getElementById("campos_estudiante");
    const divDocente = document.getElementById("campos_docente");
    const divAdmin = document.getElementById("campos_administrativo");

    // Función para ocultar todo primero
    function ocultarTodos() {
      divEstudiante.style.display = "none";
      divDocente.style.display = "none";
      divAdmin.style.display = "none";
    }

    // Escuchar cuando el usuario cambia el menú desplegable
    selectRol.addEventListener("change", function() {
      ocultarTodos();
      
      if (this.value === "Estudiante") {
        divEstudiante.style.display = "block";
      } else if (this.value === "Docente") {
        divDocente.style.display = "block";
      } else if (this.value === "Administrativo") {
        divAdmin.style.display = "block";
      }
    });
  });
</script>
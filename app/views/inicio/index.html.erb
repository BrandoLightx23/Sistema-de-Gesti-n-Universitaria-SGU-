<div style="text-align: center; margin-top: 50px; font-family: sans-serif;">
  <h1 style="color: #2c3e50;">¡Bienvenido al Sistema de Gestión Universitaria!</h1>
  
  <hr style="margin: 40px auto; width: 50%; border: 1px solid #eee;">

  <% if current_usuario %>
    <h2 style="color: #27ae60;">¡Hola, <%= current_usuario.nombre %>!</h2>
    <p style="color: #7f8c8d; font-size: 18px;">
      Has iniciado sesión como <strong><%= current_usuario.tipo_usuario %></strong>.
    </p>

    <div style="margin-top: 30px; display: flex; justify-content: center; align-items: center; gap: 15px; flex-wrap: wrap;">
      
      <% if current_usuario.tipo_usuario == 'Administrativo' %>
        <a href="/materias" style="background-color: #2980b9; color: white; padding: 10px 25px; text-decoration: none; border-radius: 6px; font-weight: bold; box-shadow: 0 2px 4px rgba(41,128,185,0.3);">
          Gestionar Materias
        </a>
        <a href="/usuarios" style="background-color: #8e44ad; color: white; padding: 10px 25px; text-decoration: none; border-radius: 6px; font-weight: bold; box-shadow: 0 2px 4px rgba(142,68,173,0.3);">
          Gestionar Usuarios
        </a>
      <% elsif current_usuario.tipo_usuario == 'Docente' %>
        <a href="/imparticiones" style="background-color: #e67e22; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold;">
          Panel Docente (Materias)
        </a>
      <% elsif current_usuario.tipo_usuario == 'Estudiante' %>
        <a href="/inscripciones" style="background-color: #8e44ad; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold;">
          Portal del Estudiante
        </a>
      <% end %>

      <%= button_to "Cerrar Sesión", logout_path, method: :delete, style: "background-color: #c0392b; color: white; padding: 10px 20px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; height: 100%; margin: 0;" %>
    </div>

  <% else %>
    <p style="color: #7f8c8d; font-size: 18px; margin-bottom: 30px;">
      Inicia sesión o regístrate para acceder al panel académico.
    </p>

    <div style="display: flex; justify-content: center; gap: 15px;">
      <a href="/login" style="background-color: #3498db; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold;">Iniciar Sesión</a>
      <a href="/registro" style="background-color: #27ae60; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold;">Crear Cuenta</a>
    </div>
  <% end %>

</div>